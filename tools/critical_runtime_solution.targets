<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Imported by Directory.Solution.targets only after gate activation.
       Every supported entry point has its own target: MSBuild's target-once
       rule must not skip qualification after a later requested runtime build. -->
  <Target Name="QualifyVpSolutionRuntimeEntry0" AfterTargets="Build" Condition="'$(SolutionFileName)' == 'VideoProcessor.sln'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(SolutionDir)tools\qualify_runtime_build.ps1&quot; -Root &quot;$(SolutionDir).&quot; -Configuration &quot;$(Configuration)&quot; -Platform &quot;$(Platform)&quot; -MagewellSdkRoot &quot;$(MagewellSdkRoot)&quot; -MSBuildPath &quot;$(MSBuildBinPath)\MSBuild.exe&quot;" />
  </Target>
  <Target Name="QualifyVpSolutionRuntimeEntry1" AfterTargets="Rebuild" Condition="'$(SolutionFileName)' == 'VideoProcessor.sln'">
