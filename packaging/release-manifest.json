{
  "schemaVersion": 1,
  "layoutVersion": "VP-0107",
  "canonicalPluginDirectory": "vprenderer",
  "directories": [
    {
      "path": "logs",
      "owner": "VideoProcessor",
      "consumer": "VideoProcessor.exe",
      "reason": "Intentionally empty release directory; the logger also recreates it when absent."
    }
  ],
  "mutableArtifacts": [
    {
      "path": "vprenderer/VideoProcessorShaderCache.bin",
      "owner": "VP Renderer",
      "consumer": "VideoProcessorVPRenderer.dll",
      "reason": "Runtime-created libplacebo shader cache; never shipped or copied from an existing deployment."
    },
    {
      "path": "logs/",
      "owner": "VideoProcessor",
      "consumer": "VideoProcessor.exe",
      "reason": "Runtime diagnostics are never release inputs; only their empty parent directory is shipped."
    },
    {
      "path": "VideoProcessor.state",
      "owner": "VideoProcessor",
      "consumer": "VideoProcessor.exe",
      "reason": "Operator state; preserved by deployment and never part of a release package."
    }
  ],
  "externalRuntimeRequirements": [
    {
      "owner": "Microsoft Visual C++ runtime",
      "sourceVersion": "VC v143 Redistributable",
      "consumer": "VideoProcessor.exe, VideoProcessorConfig.exe, VideoProcessorConfigDiscovery.dll, and VideoProcessorVPRenderer.dll",
      "loadMechanism": "Normal PE imports resolved by Windows",
      "reason": "MSVCP140, VCRUNTIME140/140_1, and MFC140U are installed system runtimes and are not copied from a developer machine."
    },
    {
      "owner": "Windows",
      "sourceVersion": "Supported Windows installation",
      "consumer": "All application binaries",
      "loadMechanism": "System32 and API-set imports",
      "reason": "Kernel, UI, COM, Direct3D, DXGI, DWM, Propsys, and CRT API-set libraries are operating-system components."
    }
  ],
  "files": [
