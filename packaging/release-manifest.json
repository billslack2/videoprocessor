    { "sourceRoot": "repository", "source": "CONFIGURATION.html", "destination": "CONFIGURATION.html", "owner": "VideoProcessor", "sourceVersion": "Current source commit", "consumer": "Operator", "loadMechanism": "Documentation", "reason": "Shipped configuration reference." },
