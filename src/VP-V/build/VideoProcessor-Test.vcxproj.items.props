<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <ClInclude Include="..\VP-V\modules\output\calibration_lut\tests\CalibrationTestSupport.h" />
    <ClCompile Include="..\VP-V\modules\output\calibration_lut\tests\CalibrationMeterTests.cpp" />
    <ClCompile Include="..\VP-V\modules\output\calibration_lut\tests\CalibrationPatternHostTests.cpp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build order only: CalibrationMeterTests runs x64/Release/test-tools/fake_spotread.exe. -->
    <ProjectReference Include="..\VideoProcessor-FakeSpotread\VideoProcessor-FakeSpotread.vcxproj">
      <Project>{6c1e2b7a-3f4d-4e8a-9b21-7d5c0a9e4f31}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>
</Project>
